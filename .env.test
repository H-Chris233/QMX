# E2E 测试环境配置
# 仅用于端到端测试，与生产环境严格隔离

# 前端配置
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_APP_ENV=test

# 后端配置
PORT=3001
NODE_ENV=test

# 测试数据库配置 - 使用独立的测试数据库
MONGODB_URI=mongodb://localhost:27017/qmx_test
# 或者使用 MongoDB Atlas 测试库
# MONGODB_URI=mongodb+srv://testuser:testpass@cluster.mongodb.net/qmx_test

# 安全配置
JWT_SECRET=test-jwt-secret-key-for-e2e-testing-only
JWT_EXPIRES_IN=1h

# 日志配置
LOG_LEVEL=error
LOG_FILE=./logs/test.log

# 速率限制配置（测试环境放宽限制）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# 测试特定配置
TEST_DATA_CLEANUP=true
TEST_SEED_DATA=true