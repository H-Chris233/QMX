{
  "name": "qmx-chris233",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:backend": "pnpm run --filter qmx-backend build",
    "test": "vitest",
    "test:frontend": "vitest",
    "test:backend": "pnpm run --filter qmx-backend test",
    "preview": "vite preview --port 1420",
    "serve": "vite preview --port 1420",
    "backend": "pnpm run --filter qmx-backend dev",
    "dev:full": "concurrently \"pnpm run backend\" \"pnpm run dev\"",
    "clean": "pnpm run --filter qmx-backend clean && rm -rf dist node_modules/.vite",
    "lint": "echo 'Run pnpm lint:frontend or pnpm lint:backend'",
    "lint:frontend": "echo 'Frontend linting would go here'",
    "lint:backend": "pnpm run --filter qmx-backend lint",
    "lint:fix": "echo 'Run pnpm lint:fix:frontend or pnpm lint:fix:backend'",
    "lint:fix:frontend": "echo 'Frontend lint fix would go here'",
    "lint:fix:backend": "pnpm run --filter qmx-backend lint:fix"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "libphonenumber-js": "^1.12.15",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.52.5",
    "@types/chai": "^4.3.20",
    "@types/chai-subset": "^1.3.6",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-c8": "^0.33.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  }
}
