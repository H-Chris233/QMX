{
  "name": "qmx-chris233",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:backend": "pnpm run --filter qmx-backend build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:backend": "pnpm run --filter qmx-backend test",
    "test:backend:coverage": "pnpm run --filter qmx-backend test:coverage",
    "coverage": "bash scripts/check-coverage.sh",
    "coverage:open": "concurrently \"open coverage/index.html\" \"open backend/coverage/index.html\"",
    "preview": "vite preview --port 1420",
    "serve": "vite preview --port 1420",
    "backend": "pnpm run --filter qmx-backend dev",
    "dev:full": "concurrently \"pnpm run backend\" \"pnpm run dev\"",
    "clean": "pnpm run --filter qmx-backend clean && rm -rf dist node_modules/.vite",
    "lint": "echo 'Run pnpm lint:frontend or pnpm lint:backend'",
    "lint:frontend": "echo 'Frontend linting would go here'",
    "lint:backend": "pnpm run --filter qmx-backend lint",
    "lint:fix": "echo 'Run pnpm lint:fix:frontend or pnpm lint:fix:backend'",
    "lint:fix:frontend": "echo 'Frontend lint fix would go here'",
    "lint:fix:backend": "pnpm run --filter qmx-backend lint:fix",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install",
    "e2e:clean": "rm -rf test-results playwright-report .playwright",
    "e2e:core": "node scripts/run-e2e-core.js",
    "e2e:core:headed": "node scripts/run-e2e-core.js --headed",
    "e2e:core:report": "node scripts/run-e2e-core.js --report",
    "e2e:core:chrome": "node scripts/run-e2e-core.js --browser chromium",
    "e2e:core:firefox": "node scripts/run-e2e-core.js --browser firefox",
    "e2e:core:safari": "node scripts/run-e2e-core.js --browser webkit",
    "e2e:verify": "node scripts/verify-e2e-structure.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "libphonenumber-js": "^1.12.15",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rollup/rollup-linux-x64-gnu": "^4.52.5",
    "@types/chai": "^4.3.20",
    "@types/chai-subset": "^1.3.6",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "happy-dom": "^14.12.0",
    "msw": "^2.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10",
    "wait-on": "^9.0.1"
  }
}
