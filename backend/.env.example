# ============================================
# QMX Backend 环境变量配置
# ============================================

# 服务器配置
PORT=3001
NODE_ENV=development

# ============================================
# PostgreSQL 数据库配置 (主数据库)
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/qmx

# 连接池配置
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000


# ============================================
# 认证配置 (站点密码)
# ============================================
# 管理员密码哈希 (bcrypt) - 可选，用于管理员覆盖访问
# 生成命令: node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your_password', 10));"
QMX_ADMIN_PASSWORD_HASH=

# bcrypt配置 (用于密码哈希)
BCRYPT_SALT_ROUNDS=10

# JWT配置（生产环境务必修改）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ============================================
# CORS配置
# ============================================
# 多个域名请用英文逗号分隔，例如:
# CORS_ORIGIN=https://admin.example.com,https://app.example.com
CORS_ORIGIN=http://localhost:1420

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
# 生产环境建议开启标准输出（容器友好）
LOG_STDOUT=false

# ============================================
# 速率限制配置
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# API 路由专用限流（默认：开发环境 300/60s，生产环境 60/60s）
API_RATE_LIMIT_MAX_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# 分页配置（可选）
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# 请求体大小限制（可选）
REQUEST_BODY_LIMIT=10mb

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Swagger 文档开关（可选）
ENABLE_SWAGGER=true

# ============================================
# Redis 缓存配置（后端）
# ============================================
# 启用/禁用Redis缓存（默认: true）
REDIS_ENABLED=true

# Redis服务器地址（默认: localhost）
REDIS_HOST=localhost

# Redis端口（默认: 6379）
REDIS_PORT=6379

# Redis密码（可选）
REDIS_PASSWORD=

# Redis数据库编号（默认: 0）
REDIS_DB=0

# 测试辅助（仅测试环境）
TEST_DATA_CLEANUP=false
