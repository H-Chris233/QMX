# ============================================
# QMX Backend 环境变量配置
# ============================================

# 服务器配置
PORT=3001
NODE_ENV=development

# ============================================
# PostgreSQL 数据库配置 (主数据库)
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/qmx

# 连接池配置
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ============================================
# MongoDB 配置 (已废弃，保留用于历史迁移)
# ============================================
MONGODB_URI=mongodb://localhost:27017/qmx

# ============================================
# 认证配置 (站点密码)
# ============================================
# 管理员密码哈希 (bcrypt) - 可选，用于管理员覆盖访问
# 生成命令: node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your_password', 10));"
QMX_ADMIN_PASSWORD_HASH=

# bcrypt配置 (用于密码哈希)
BCRYPT_SALT_ROUNDS=10

# ============================================
# CORS配置
# ============================================
CORS_ORIGIN=http://localhost:1420

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# 速率限制配置
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
