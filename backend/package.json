{
  "name": "qmx-backend",
  "version": "1.0.0",
  "description": "QMX Backend Server - Student and Financial Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "npm run clean && tsc",
    "build:check": "tsc --noEmit",
    "start": "npm run build && node -r ./bootstrap.js dist/index.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "start:watch": "nodemon --exec 'npm run build && npm start'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "seed": "ts-node src/scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "sh ./scripts/db-migrate.sh",
    "db:push": "sh ./scripts/db-push.sh",
    "db:studio": "NODE_OPTIONS=--dns-result-order=ipv4first drizzle-kit studio",
    "db:drop": "NODE_OPTIONS=--dns-result-order=ipv4first drizzle-kit drop",
    "docs:serve": "echo 'API 文档可在 http://localhost:3001/api-docs 访问（运行 pnpm dev 后）'"
  },
  "keywords": [
    "education",
    "student-management",
    "financial-management",
    "typescript",
    "express"
  ],
  "author": "Chris233",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.9.1",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^5.0.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.20",
    "@types/chai-subset": "^1.3.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/estree": "^1.0.8",
    "@types/express": "^5.0.1",
    "@types/ioredis": "^5.0.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.19.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
