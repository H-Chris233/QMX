# 前端开发服务器配置
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ============================================
# 认证配置
# ============================================
# 管理员密码哈希 (bcrypt) - 可选，用于管理员访问
# 生成命令: cd backend && node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your_password', 10));"
VITE_ADMIN_PASSWORD_HASH=

# ============================================
# Redis 缓存配置（后端）
# ============================================
# 启用/禁用Redis缓存（默认: true）
REDIS_ENABLED=true

# Redis服务器地址（默认: localhost）
REDIS_HOST=localhost

# Redis端口（默认: 6379）
REDIS_PORT=6379

# Redis密码（可选）
# REDIS_PASSWORD=your_redis_password

# Redis数据库编号（默认: 0）
REDIS_DB=0
